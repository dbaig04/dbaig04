# RISE <-> Meteora DLMM arb bot — environment template.
# Copy to /etc/rise-arb/bot.env (systemd EnvironmentFile) or export in your shell.
# Placeholders only: put your real ERPC endpoints / tokens in the copy, never in git.
# Every feed is OFF unless its endpoint is set; with nothing set the bot polls RPC_URL.

# ---------------------------------------------------------------- mode / safety
# simulate (default, read-only paper trading) | live
MODE=simulate
# Live needs all three: MODE=live, KEYPAIR_PATH and CONFIRM_LIVE=yes
#KEYPAIR_PATH=/etc/rise-arb/bot.keypair.json
#CONFIRM_LIVE=yes
# Wallet to paper-trade as when no keypair is given (default: the reference wallet)
#SIM_USER=24Q5e2FRebiFs3iWvN6pZYA4UTGzA3WUsci4ChhgfYEU

# ---------------------------------------------------------------- RPC (reads, simulation, status)
# ERPC Solana RPC endpoint from your ERPC dashboard (include the API key the way ERPC gives it)
RPC_URL=https://<your-erpc-rpc-endpoint>
# Optional explicit WebSocket endpoint for RPC_URL (default: derived from RPC_URL)
#WS_URL=wss://<your-erpc-ws-endpoint>
# State/confirmation commitment for RPC: processed | confirmed | finalized
COMMITMENT=confirmed

# ---------------------------------------------------------------- delivery (ERPC SWQoS endpoint)
# sendRawTransaction goes here (rebroadcast until confirmed/expired); statuses are polled on RPC_URL.
# Unset = send via RPC_URL.
#SEND_RPC_URL=https://<your-erpc-swqos-send-endpoint>
# Keep the send connection warm with a cheap request every N ms (0 = off)
SEND_RPC_WARM_MS=0
REBROADCAST_MS=2000

# rpc (default: sendRawTransaction to SEND_RPC_URL / RPC_URL) | jito (single-tx bundle with an in-tx tip)
# (ab = live delivery A/B; refused unless MODE=live, CONFIRM_LIVE=yes and DELIVERY_COMPARE_LIVE=yes)
DELIVERY=rpc
#JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
#JITO_UUID=<optional-x-jito-auth-uuid>
#JITO_TIP_ACCOUNTS_TTL_MS=600000

# ---------------------------------------------------------------- ERPC Geyser gRPC (Yellowstone)
# Setting GRPC_ENDPOINT switches state to the streamed account feed (RPC polling stays as fallback)
# and makes the main loop event-driven.
#GRPC_ENDPOINT=https://<your-erpc-geyser-grpc-endpoint>
# Sent as the `x-token` header; leave unset if your plan authenticates by IP allowlist
#GRPC_X_TOKEN=<your-grpc-token>
# processed | confirmed | finalized (default: COMMITMENT). processed is fastest but can include
# state from forks that are later dropped; every trade is still simulated first.
#GRPC_COMMITMENT=confirmed
#GRPC_PING_MS=10000
# No stream message for this long => stale: stop trusting the stream, poll RPC instead
#GRPC_STALE_MS=3000
# Max wait after the first update of a slot before re-evaluating (a slot status flushes earlier)
#GRPC_DEBOUNCE_MS=20
#GRPC_RECONNECT_MIN_MS=250
#GRPC_RECONNECT_MAX_MS=15000

# ---------------------------------------------------------------- ERPC Shreds UDP Forwarding (raw shreds)
# ERPC forwards raw turbine shreds as UDP to this VPS. Setting SHREDS_UDP_PORT turns the
# ingestor on (and SHREDSTREAM_ENDPOINT below off). Early, unconfirmed signal only: logs pending
# competing arbs / pool swaps and wakes the engine. Never applied to state.
# Port configured in your ERPC dashboard; open it for ERPC's source IPs only, e.g.
#   sudo ufw allow proto udp from <erpc-forwarder-ip-1> to any port 20000
#SHREDS_UDP_PORT=20000
#SHREDS_UDP_BIND=0.0.0.0
# ERPC's forwarder source IPs (comma-separated). Unset = accept any source (logged as a warning).
#SHREDS_UDP_ALLOWED_SOURCES=<erpc-forwarder-ip-1>,<erpc-forwarder-ip-2>
# Requested socket receive buffer (bytes). The kernel caps it at net.core.rmem_max:
#   sudo sysctl -w net.core.rmem_max=134217728   (persist in /etc/sysctl.d/)
#SHREDS_UDP_RCVBUF=67108864
# Optional: expected cluster shred version (drop others)
#SHREDS_UDP_SHRED_VERSION=<cluster-shred-version>
# Reed-Solomon recovery of missing data shreds from coding shreds (1/0)
#SHREDS_UDP_RECOVERY=1
# Evict slots this far behind the newest one; cap on buffered shred memory
#SHREDS_UDP_MAX_SLOT_LAG=12
#SHREDS_UDP_MAX_BUFFER_MB=128
# Summary log line + ledger `latency` row (kind shreds-udp) period (default LATENCY_SUMMARY_MS)
#SHREDS_UDP_SUMMARY_MS=60000
#SHREDS_UDP_STALE_MS=5000

# ---------------------------------------------------------------- ERPC ShredStream (gRPC SubscribeEntries) — alternative
# Only used when SHREDS_UDP_PORT is unset.
# Early, unconfirmed signal: logs pending competing arbs / pool swaps and wakes the engine.
# Never applied to state.
#SHREDSTREAM_ENDPOINT=https://<your-erpc-shreds-endpoint>
# Sent as `x-token` if set (ERPC's own client sends none: likely IP-allowlisted)
#SHREDSTREAM_X_TOKEN=<your-shreds-token>
# Ask ERPC to pre-filter by account (their filter is marked experimental). 0 = full stream, filter locally.
#SHREDSTREAM_SERVER_FILTER=0
#SHREDSTREAM_STALE_MS=5000
# (shared by both shred paths) Resolve v0 lookup tables (via RPC_URL) for txs that look relevant, to see pool/RISE keys hidden in ALTs
#SHREDS_RESOLVE_ALTS=1
# Skip a trade while a competing arb on the pool is pending (seen in shreds, not yet in our snapshot)
SHREDS_HOLD_ON_COMPETING_ARB=0
#SHREDS_HOLD_WINDOW_MS=1500

# ---------------------------------------------------------------- strategy / fees
PROFIT_FLOOR_LAMPORTS=100000
PRIORITY_FEE_LAMPORTS=50000
BASE_FEE_LAMPORTS=5000
# max leg-1 input per trade (risk limit, 0.1 SOL)
MAX_TRADE_LAMPORTS=100000000
MIN_TRADE_LAMPORTS=1000000
MAX_WSOL_LAMPORTS=5000000000
LEG_SLIPPAGE_BPS=0
SIM_TOLERANCE_LAMPORTS=20000
SIM_TOLERANCE_BPS=1000
CU_HEADROOM_BPS=11500
MAX_SESSION_LOSS_LAMPORTS=2000000

# ---------------------------------------------------------------- risk limits (defaults = operator limits)
# None of these enables live trading. Daily limits and the failure streak persist in RISK_STATE_PATH.
MAX_PRIORITY_FEE_LAMPORTS=50000
MAX_TIP_LAMPORTS=50000
# priority + tip <= this share (bps) of the expected profit before execution costs (1000 = 10%)
MAX_EXEC_COST_BPS_OF_PROFIT=1000
# min expected net profit after base + priority + tip
MIN_NET_PROFIT_LAMPORTS=100000
# stop for the UTC day at this sum of fees + tips of landed txs (success or failure), regardless of profit
MAX_DAILY_EXEC_COST_LAMPORTS=5000000
# stop for the UTC day at this realized SOL loss
MAX_DAILY_LOSS_LAMPORTS=10000000
# stop after N unsuccessful txs in a row (clear: npx tsx src/engine/estop.ts clear-failures)
MAX_CONSECUTIVE_FAILURES=3
EXPIRED_COUNTS_AS_FAILURE=1
# refuse to build/send on a snapshot this many slots behind the newest seen / this old
MAX_STALE_SLOTS=8
MAX_STALE_MS=3000
# sender refuses a tx whose exact message did not simulate OK within this window
SIM_MAX_AGE_MS=3000
# RISE + Meteora DLMM programdata deploy-slot check period (any change halts until restart)
UPGRADE_CHECK_MS=30000
# emergency stop: touch the kill file, kill -USR1 <pid>, or npx tsx src/engine/estop.ts
KILL_FILE=data/STOP
RISK_STATE_PATH=data/risk-state.json
PID_FILE=data/bot.pid

# ---------------------------------------------------------------- loop / logging
# Poll period without feeds; with gRPC/Shreds it is the max time between ticks
POLL_INTERVAL_MS=1000
LEDGER_PATH=data/ledger.jsonl
# Period of the latency summary row in the ledger (0 = off)
LATENCY_SUMMARY_MS=60000

# ---------------------------------------------------------------- only behind an HTTPS proxy (not on the VPS)
#NODE_USE_ENV_PROXY=1
